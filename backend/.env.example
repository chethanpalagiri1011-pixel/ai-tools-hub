APP_NAME="ShopEasy E-Commerce API"
APP_ENV="development"
DEBUG=True
SECRET_KEY="your-secret-key-here"
API_PREFIX="/api/v1"

# Async database URL (e.g., postgresql+asyncpg://user:password@localhost:5432/ecommerce_db)
DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/ecommerce_db"
# Sync database URL for migrations (e.g., postgresql://user:password@localhost:5432/ecommerce_db)
DATABASE_URL_SYNC="postgresql://user:password@localhost:5432/ecommerce_db"

JWT_SECRET_KEY="your-jwt-secret-key"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500"

MOCK_PAYMENT_ENABLED=True
LLM_API_KEY=""
