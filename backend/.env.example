# ShopEasy Environment Configuration Example

APP_NAME="ShopEasy E-Commerce API"
APP_ENV="production"
DEBUG=False
SECRET_KEY="super-secret-key-change-in-production-environment"
API_PREFIX="/api/v1"

# Database Configuration (PostgreSQL or SQLite)
DATABASE_URL="sqlite+aiosqlite:///./shopeasy.db"
DATABASE_URL_SYNC="sqlite:///./shopeasy.db"

# JWT Authentication
JWT_SECRET_KEY="jwt-super-secret-key-change-in-production"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

CORS_ORIGINS="*"
MOCK_PAYMENT_ENABLED=True
LLM_API_KEY=""

# ==================================================
# REAL SMS OTP AUTHENTICATION (TWILIO)
# ==================================================
# Enforce Real SMS sending (Never shows OTP on webpage or returns in API)
OTP_DEVELOPMENT_MODE=False

# SMS Provider (TWILIO)
SMS_PROVIDER="TWILIO"

# Enter your 3 Twilio Credentials below:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
